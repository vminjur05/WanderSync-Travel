<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".views.AccommodationsFragment">

    <!-- RecyclerView to display the list of accommodations -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/accommodationsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fastScrollEnabled="true" />

    <!-- Floating Action Button for adding new accommodations -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_popup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="Open popup"
        android:src="@android:drawable/ic_input_add" />

    <!-- Sort By Date Buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp">

        <!-- Button to sort by check-in date -->
        <Button
            android:id="@+id/sortByCheckInButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sort by Check-in" />

        <!-- Button to sort by check-out date -->
        <Button
            android:id="@+id/sortByCheckOutButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sort by Check-out" />

        <!-- Button to filter by date -->
        <Button
            android:id="@+id/filterByDateButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filter by Date" />
    </LinearLayout>
</FrameLayout>
