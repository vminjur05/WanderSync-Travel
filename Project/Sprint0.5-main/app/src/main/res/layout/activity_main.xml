<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginBottom="50dp"> <!-- Adjust this margin if needed to move texts above buttons -->

        <!-- First TextView for "Welcome To" -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome To"
            android:textSize="20sp"
            android:textColor="@android:color/black"
            android:gravity="left"/>

        <!-- Second TextView for "WanderSync!" - larger and darker -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WanderSync!"
            android:textSize="28sp"
            android:textColor="@android:color/darker_gray"
            android:gravity="left"/>

        <!-- The two buttons below the text -->
        <Button
            android:id="@+id/btnStart"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:text="Start"
            android:backgroundTint="@android:color/black"
            android:textColor="@android:color/white"
            android:paddingHorizontal="20dp"
            android:minHeight="48dp"/>

        <Button
            android:id="@+id/btnQuit"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:text="Quit"
            android:backgroundTint="@android:color/darker_gray"
            android:textColor="@android:color/white"
            android:paddingHorizontal="20dp"
            android:minHeight="48dp"/>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>